{
  "name": "forestilling-bot",
  "description": "Bot som lager Discord kanaler for forestillingskvelder.",
  "scripts": {
    "start": "rm -r -f build && npm run lint && tsc && node build/main.js",
    "lint": "eslint .",
    "lintFix": "eslint . --fix",
    "transpile": "tsc",
    "deployCommands": "rm -r -f build && tsc && node ./build/scripts/deployDiscordCommands.js",
    "generateSmartSuiteTypes": "rm -r -f build && tsc && node ./build/scripts/generateSmartSuiteTypes.js"
  },
  "type": "module",
  "author": "Simon Mørland",
  "license": "MIT",
  "dependencies": {
    "@google-cloud/pubsub": "^5.3.1",
    "app-root-path": "3.1.0",
    "discord.js": "^14.27.0",
    "dotenv": "17.4.2",
    "googleapis": "173.0.0",
    "mailparser": "3.9.14",
    "nodemailer": "9.0.1",
    "schedgeup-scraper": "3.2.5",
    "sqlite": "5.1.1",
    "sqlite3": "6.0.1",
    "bullmq": "^5.56.4",
    "smartsuite-typescript-api": "0.1.0"
  },
  "devDependencies": {
    "typescript": "5.8.3",
    "@types/mailparser": "3.4.6",
    "@types/nodemailer": "8.0.0",
    "eslint-config-dat": "2.0.1"
  }
}
