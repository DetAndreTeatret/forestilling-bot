    "bullmq": "^6.0.0",
    "discord.js": "^14.27.0",
    "dotenv": "18.0.10",
    "googleapis": "189.0.0",
    "ioredis": "^6.0.0",
    "mailparser": "3.14.2",
    "nodemailer": "10.6.1",
    "sqlite": "5.1.1",
    "sqlite3": "6.0.1"
  },
  "//":  "TODO: two versions of TS are imported since TS7.0 does not include the api eslint needs to work, the api should be added in TS7.1, and the the import for TS6 can be removed",
  "devDependencies": {
    "@types/mailparser": "3.9.0",
    "@types/nodemailer": "8.0.2",
    "eslint": "^10.15.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "@typescript/native": "npm:typescript@^7.0.2"
  },
  "workspaces": ["schedgeup-scraper", "eslint-config-dat"]

